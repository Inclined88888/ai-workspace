FROM node:22-bookworm-slim
# Official, unmodified CLI. Never silently upgrade or fall back to another version.
RUN npm install --global --no-audit --no-fund @anthropic-ai/claude-code@2.1.308 \
    && npm cache clean --force \
    && mkdir -p /workspace /home/node/.claude \
    && chown -R node:node /workspace /home/node/.claude
COPY --chown=node:node server.mjs /app/server.mjs
ENV HOME=/home/node \
    CLAUDE_CONFIG_DIR=/home/node/.claude \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    DISABLE_AUTOUPDATER=1
USER node
WORKDIR /workspace
CMD ["node", "/app/server.mjs"]
