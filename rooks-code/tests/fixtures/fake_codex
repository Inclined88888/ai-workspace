#!/usr/bin/env python3
"""A stand-in for the official `codex` CLI: `login status` and `exec --json` JSONL events (shapes from the Codex docs)."""
import json
import os
import sys

args = sys.argv[1:]
state = os.environ.get("FAKE_CODEX_STATE", "signed_in")
log = os.environ.get("FAKE_CODEX_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps({"argv": args, "has_openai_key": "OPENAI_API_KEY" in os.environ}) + "\n")
if args == ["--version"]:
    print("codex-cli 0.166.0")
    sys.exit(0)
if args[:2] == ["login", "status"]:
    if state == "signed_out":
        print("Not logged in", file=sys.stderr)
        sys.exit(1)
    print("Logged in using ChatGPT", file=sys.stderr)
    sys.exit(0)
if not args or args[0] != "exec":
    sys.exit(2)
assert "danger-full-access" not in " ".join(args)
prompt = sys.stdin.read()
writable = 'sandbox_mode="workspace-write"' in args
out = lambda o: print(json.dumps(o), flush=True)  # noqa: E731
out({"type": "thread.started", "thread_id": "0199a213-81c0-7800-8aa1-bbab2a035a53"})
out({"type": "turn.started"})
out({"type": "item.started", "item": {"id": "item_1", "type": "command_execution", "command": "bash -lc ls", "status": "in_progress"}})
out({"type": "item.completed", "item": {"id": "item_1", "type": "command_execution", "command": "bash -lc ls", "aggregated_output": "README.md\n", "exit_code": 0, "status": "completed"}})
if writable:
    with open("codex.txt", "w") as f:
        f.write("hi from codex\n")
    out({"type": "item.completed", "item": {"id": "item_2", "type": "file_change", "changes": [{"path": "codex.txt", "kind": "add"}], "status": "completed"}})
    msg = "Added codex.txt."
else:
    msg = "Plan: add codex.txt. I can't write files in the read-only sandbox."
out({"type": "item.completed", "item": {"id": "item_3", "type": "agent_message", "text": msg}})
out({"type": "turn.completed", "usage": {"input_tokens": 500, "cached_input_tokens": 0, "output_tokens": 40}})
