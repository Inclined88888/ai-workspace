#!/usr/bin/env python3
"""A stand-in for the official `claude` CLI, speaking its real stream-json shapes (captured from Claude Code 2.1.314).

FAKE_CLAUDE_STATE: "signed_in" (default), "signed_out" or "api_key". FAKE_CLAUDE_LOG: file to append each argv/env to.
The job: write hello.txt (an edit) and run `echo tested` (a command). Each needs approval unless allowed by
--permission-mode acceptEdits (edits only) or --allowedTools.
"""
import json
import os
import sys
import uuid

args = sys.argv[1:]
state = os.environ.get("FAKE_CLAUDE_STATE", "signed_in")
log = os.environ.get("FAKE_CLAUDE_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps({"argv": args, "has_anthropic_key": "ANTHROPIC_API_KEY" in os.environ, "cwd": os.getcwd()}) + "\n")

if args == ["--version"]:
    print("2.1.314 (Claude Code)")
    sys.exit(0)
if args[:2] == ["auth", "status"]:
    print(json.dumps({"loggedIn": state != "signed_out", "authMethod": {"signed_in": "claude.ai", "api_key": "api_key"}.get(state, "none"),
                      "apiProvider": "firstParty"}, indent=2))
    sys.exit(0)
if args == ["--help"]:
    print('--permission-mode <mode>  (choices: "acceptEdits", "auto", "bypassPermissions", "manual", "dontAsk", "plan")')
    sys.exit(0)
if "-p" not in args:
    sys.exit(2)
assert "bypassPermissions" not in args and "--dangerously-skip-permissions" not in args, "never bypass"

prompt = sys.stdin.read()
mode = args[args.index("--permission-mode") + 1]
allowed = args[args.index("--allowedTools") + 1].split(",") if "--allowedTools" in args else []
sid = args[args.index("--resume") + 1] if "--resume" in args else str(uuid.uuid4())


def out(o):
    print(json.dumps(o), flush=True)


out({"type": "system", "subtype": "init", "cwd": os.getcwd(), "session_id": sid, "model": "claude-opus-5-5",
     "permissionMode": "default" if mode == "manual" else mode, "claude_code_version": "2.1.314", "apiKeySource": "none"})
if state == "signed_out":
    out({"type": "assistant", "message": {"content": [{"type": "text", "text": "Not logged in · Please run /login"}]},
         "session_id": sid, "error": "authentication_failed", "parent_tool_use_id": None})
    out({"type": "result", "subtype": "success", "is_error": True, "result": "Not logged in · Please run /login", "session_id": sid,
         "permission_denials": [], "total_cost_usd": 0, "usage": {"input_tokens": 0, "output_tokens": 0}, "num_turns": 1})
    sys.exit(1)

denials = []
out({"type": "assistant", "message": {"content": [{"type": "thinking", "thinking": "Plan: write the file, then test."},
     {"type": "text", "text": f"Working on: {prompt[:60]}"}]}, "session_id": sid, "parent_tool_use_id": None})
edit_ok = mode == "acceptEdits" or "Write" in allowed
write = {"file_path": os.path.join(os.getcwd(), "hello.txt"), "content": "hello from claude\n"}
out({"type": "assistant", "message": {"content": [{"type": "tool_use", "id": "toolu_w", "name": "Write", "input": write}]}, "session_id": sid, "parent_tool_use_id": None})
if mode == "plan" or not edit_ok:
    denials.append({"tool_name": "Write", "tool_use_id": "toolu_w", "tool_input": write})
    out({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": "toolu_w", "is_error": True,
         "content": "Claude requested permissions to write to hello.txt, but you haven't granted it yet."}]}, "session_id": sid})
else:
    with open("hello.txt", "w") as f:
        f.write(write["content"])
    out({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": "toolu_w", "content": "File created"}]}, "session_id": sid})
bash = {"command": "echo tested"}
out({"type": "assistant", "message": {"content": [{"type": "tool_use", "id": "toolu_b", "name": "Bash", "input": bash}]}, "session_id": sid, "parent_tool_use_id": None})
if "Bash(echo tested)" in allowed and mode != "plan":
    out({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": "toolu_b", "content": "tested"}]}, "session_id": sid})
else:
    denials.append({"tool_name": "Bash", "tool_use_id": "toolu_b", "tool_input": bash})
    out({"type": "system", "subtype": "permission_denied", "tool_name": "Bash", "session_id": sid})
done = not denials
text = "Wrote hello.txt and the test passed." if done else "I need your approval to continue."
out({"type": "assistant", "message": {"content": [{"type": "text", "text": text}]}, "session_id": sid, "parent_tool_use_id": None})
out({"type": "result", "subtype": "success", "is_error": False, "result": text, "session_id": sid, "permission_denials": denials,
     "total_cost_usd": 0.0123, "usage": {"input_tokens": 1200, "output_tokens": 80, "cache_read_input_tokens": 0}, "num_turns": 3,
     "duration_ms": 900})
