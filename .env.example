# Copy to .env, or let ./setup.sh write it for you.
# Never commit .env: it holds your secrets.

WORKSPACE_NAME=AI Workspace
# IANA timezone for schedules and the assistant's clock (setup.sh detects it)
WORKSPACE_TIMEZONE=UTC

# The core is one container (Workbench). Everything else is an optional add-on, off by default.
# Add-ons: search, browser, local-models, openwebui, paperclip, hermes
# Easiest: ./setup.sh --with search,browser   (writes both lines below for you)
ADDONS=
COMPOSE_PROFILES=

# 127.0.0.1 = only reachable from this machine (use a reverse proxy or SSH tunnel for remote access).
# 0.0.0.0   = reachable on your network. Only do this behind a firewall or HTTPS reverse proxy.
BIND_ADDRESS=127.0.0.1
WEBUI_PORT=3000
WORKBENCH_PORT=3100
PAPERCLIP_PORT=3200
HERMES_DASHBOARD_PORT=3300
# Public URL of the chat app (used for links). Change when behind a domain.
WEBUI_PUBLIC_URL=http://localhost:3000
PAPERCLIP_PUBLIC_URL=http://localhost:3200
HERMES_PUBLIC_URL=http://localhost:3300
# Extra hostnames Paperclip accepts (LAN IP, Tailscale name), comma separated
PAPERCLIP_ALLOWED_HOSTNAMES=

# Secrets: generate each with `openssl rand -hex 32`
# Only APP_SECRET and TOOLS_API_KEY are required for the core; the rest belong to add-ons.
WEBUI_SECRET_KEY=
APP_SECRET=
TOOLS_API_KEY=
SEARXNG_SECRET=
BROWSER_API_KEY=
PAPERCLIP_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SECRET=
PAPERCLIP_AGENT_JWT_SECRET=
HERMES_API_KEY=
HERMES_DASHBOARD_SECRET=
# Hermes dashboard login (user admin)
HERMES_DASHBOARD_PASSWORD=
# One time code required by the Workbench setup screen
SETUP_CODE=

# Add-on URLs as seen from the Workbench container. Empty = add-on off.
# setup.sh fills these. Native Ollama on a Mac: OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=
SEARXNG_URL=
BROWSER_URL=
CHAT_URL=
PAPERCLIP_URL=
HERMES_URL=

# Default local model pulled by setup.sh and used by Workbench
DEFAULT_MODEL=qwen3:4b
# Context window Workbench asks Ollama for, in tokens. Ollama's own default (4096) silently cuts long prompts.
# Cache memory grows with it: roughly 2.4 GB per 16K tokens on a 4B model.
OLLAMA_NUM_CTX=16384

# Optional cloud providers (Workbench seeds these on first start; edit later in Settings)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# OpenCode Zen account key: unlocks OpenCode's free tier models for Paperclip employees
OPENCODE_API_KEY=

# The browser agent uses the models connected in Workbench (Settings → Model providers), through Workbench, and its
# spend is in Workbench's usage. Paperclip and Hermes browser runs use Workbench's default model.
# Hard cap on agent steps per month across all callers (0 = unlimited). Pick a local model for $0.
BROWSER_MONTHLY_STEP_LIMIT=2000

# Optional providers for the chat app (semicolon separated, same order for URLs and keys)
WEBUI_ENABLE_OPENAI_API=false
WEBUI_OPENAI_API_BASE_URLS=
WEBUI_OPENAI_API_KEYS=
WEBUI_ENABLE_WEB_SEARCH=false

# Set to true once Workbench is served over HTTPS
COOKIE_SECURE=false

# Pin image versions for reproducible upgrades (defaults: latest / main)
# PAPERCLIP_TAG=latest
# HERMES_TAG=latest
# OLLAMA_TAG=latest
# OPEN_WEBUI_TAG=main
# SEARXNG_TAG=latest
